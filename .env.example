# .env.example
# 伺服器啟動的 Port
PORT=3000

NODE_ENV=development

# 連到 Docker PostgreSQL 的連線字串
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/gcp_dev_db?schema=public"

# 我們剛剛用的 JWT 金鑰
JWT_SECRET=this-is-a-very-long-and-safe-secret-key
JWT_EXPIRES_IN=7d

# Redis 連線設定
REDIS_URL=redis://localhost:6379

# GCP的Auth，用戶端ID
DRIVE_CLIENT_ID=
# GCP的Auth，用戶端密碼
DRIVE_CLIENT_SECRET=
# OAuth 2.0 Playground頁面產生的長效通行證，Scope去掉.file，API可以找到所有東西
DRIVE_REFRESH_TOKEN=


# 如果git持續追蹤.env裡面的東西，在終端機輸入以下指令：
# 1. 將 .env 從 Git 的追蹤清單移除 (但保留實體檔案)
git rm --cached .env
# 2. 提交這個「不再追蹤」的動作
git commit -m "chore: remove .env from tracking"
